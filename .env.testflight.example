# Build-time Zephyr authentication. Never commit a real value.
ZE_SECRET_TOKEN=sntryu_replace_me
ZEPHYR_DISTRIBUTION=testflight
ZEPHYR_TARGET=ios
ZE_FAIL_BUILD=true

# Set these only after the identifiers are reserved and confirmed.
IOS_BUNDLE_ID=io.zephyr-cloud.health
APPLE_TEAM_ID=replace_me
IOS_BUILD_NUMBER=1

# Optional strict external-release verification inputs. Internal TestFlight
# commands rely on the Zephyr plugin/runtime and do not require these URLs.
# ZEPHYR_MINI_MANIFEST_URL=https://replace-me.zephyrcloud.app/mf-manifest.json
# ZEPHYR_NESTED_MINI_MANIFEST_URL=https://replace-me.zephyrcloud.app/mf-manifest.json
