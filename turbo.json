{
  "$schema": "https://turbo.build/schema.json",
  "ui": "tui",
  "globalDependencies": [".env.e2e"],
  "globalPassThroughEnv": [
    "REMOTE_VERSION",
    "ZEPHYR_E2E",
    "ZEPHYR_DISTRIBUTION",
    "ZEPHYR_TARGET"
  ],
  "tasks": {
    "dev": {
      "cache": false,
      "persistent": true,
      "dependsOn": ["//#refresh"]
    },
    "dev:cached": {
      "cache": false,
      "persistent": true
    },
    "//#refresh": {
      "cache": false
    }
  }
}
