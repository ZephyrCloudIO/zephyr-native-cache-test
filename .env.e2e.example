# Environment for the real-Zephyr e2e flow (`pnpm e2e:zephyr`).
#
# Copy to `.env.e2e` and fill in. `pnpm e2e:zephyr` auto-loads the file via
# Node's `--env-file-if-exists`, so no `source` step needed. Env vars already
# present in your shell take precedence. Preflight fails fast if any of these
# are still missing at run time.
# The mocked `pnpm e2e` flow ignores this file entirely.

# Zephyr edge gateway. `ZE_API_GATE` is the stable preview gateway hostname;
# `ZE_API` is the per-PR Heroku backend that the gateway proxies to when
# `ZE_IS_PREVIEW=true`. Change `ZE_API` to the PR number you want to hit.
ZE_API_GATE=https://zeapi.zephyrcloudapp.dev
ZE_API=https://api-zephyr-ci-pr-3379.herokuapp.com
ZE_IS_PREVIEW=true

# Personal auth token — Zephyr dashboard → profile → access tokens.
# Required. No interactive login fallback.
ZE_SECRET_TOKEN=sntryu_replace_me

# Optional: override the app UIDs the host resolves through Zephyr. Defaults
# to bare names `mini` and `nested-mini`, which Zephyr auto-registers on
# first publish (so first run just works).
# ZEPHYR_MINI_UID=mini
# ZEPHYR_NESTED_MINI_UID=nested-mini
