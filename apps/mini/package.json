{
  "name": "cache-test-mini",
  "version": "0.0.1",
  "private": true,
  "scripts": {
    "android": "rnef run:android",
    "ios": "rnef run:ios",
    "lint": "ESLINT_USE_FLAT_CONFIG=false eslint .",
    "dev": "rnef start --port 8082 --reset-cache",
    "dev:cached": "rnef start --port 8082",
    "start": "rnef start --port 8082",
    "test": "jest",
    "pods": "(cd ios && bundle install && (bundle exec pod install || bundle exec pod update))",
    "build:ios": "rnef bundle-mf-remote --platform ios --dev false",
    "build:android": "rnef bundle-mf-remote --platform android --dev false",
    "publish:ios": "ZEPHYR_E2E=1 rnef bundle-mf-remote --platform ios --dev false",
    "publish:android": "ZEPHYR_E2E=1 rnef bundle-mf-remote --platform android --dev false",
    "serve:ios": "serve dist/ios -p 8082",
    "serve:android": "serve dist/android -p 8082",
    "adbreverse": "adb reverse tcp:8082 tcp:8082"
  },
  "dependencies": {
    "@react-native/new-app-screen": "0.80.3",
    "lodash": "4.18.1",
    "react": "19.1.0",
    "react-native": "0.80.0"
  },
  "devDependencies": {
    "@babel/core": "^7.25.2",
    "@babel/preset-env": "^7.25.3",
    "@babel/runtime": "^7.25.0",
    "@module-federation/metro": "2.9.0",
    "@module-federation/metro-plugin-rnef": "2.9.0",
    "@module-federation/runtime": "2.9.0",
    "@react-native-community/cli": "^19.1.0",
    "@react-native/babel-preset": "0.80.0",
    "@react-native/eslint-config": "0.80.0",
    "@react-native/metro-config": "0.80.0",
    "@react-native/typescript-config": "0.80.0",
    "@rnef/cli": "^0.7.25",
    "@rnef/platform-android": "^0.7.25",
    "@rnef/platform-ios": "^0.7.25",
    "@rnef/plugin-metro": "^0.7.25",
    "@types/jest": "^29.5.13",
    "@types/lodash": "^4",
    "@types/react": "^19.1.0",
    "@types/react-test-renderer": "^19.1.0",
    "eslint": "^8.57.1",
    "jest": "^29.6.3",
    "prettier": "2.8.8",
    "react-test-renderer": "19.1.0",
    "serve": "^14.2.4",
    "typescript": "5.0.4",
    "zephyr-metro-plugin": "1.2.2",
    "zephyr-metro-rnef-plugin": "workspace:*"
  },
  "engines": {
    "node": ">=18"
  }
}
