{
  "name": "zephyr-native-cache-test",
  "version": "0.0.1",
  "private": true,
  "scripts": {
    "dev": "turbo run dev",
    "build:mf-core": "bash scripts/build-mf-core.sh",
    "build:native-cache": "bash scripts/build-native-cache.sh",
    "refresh": "pnpm install",
    "run:ios": "cd apps/host && pnpm exec rnef run:ios"
  },
  "devDependencies": {
    "turbo": "^2.8.0"
  },
  "packageManager": "pnpm@10.33.0",
  "engines": {
    "node": ">=20"
  },
  "pnpm": {
    "overrides": {
      "@module-federation/error-codes": "file:./tarballs/module-federation-error-codes.tgz",
      "@module-federation/sdk": "file:./tarballs/module-federation-sdk.tgz",
      "@module-federation/runtime-core": "file:./tarballs/module-federation-runtime-core.tgz",
      "@module-federation/runtime": "file:./tarballs/module-federation-runtime.tgz"
    }
  }
}
