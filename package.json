{
  "name": "zephyr-native-cache-test",
  "version": "0.0.1",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "bash scripts/dev.sh",
    "dev:v1": "bash scripts/check-ports.sh && REMOTE_VERSION=v1 turbo run dev",
    "dev:v2": "bash scripts/check-ports.sh && REMOTE_VERSION=v2 turbo run dev",
    "dev:v3": "bash scripts/check-ports.sh && REMOTE_VERSION=v3 turbo run dev",
    "dev:cached": "bash scripts/check-ports.sh && turbo run dev:cached",
    "dev:raw": "bash scripts/check-ports.sh && turbo run dev",
    "build:mf-core": "bash scripts/build-mf-core.sh",
    "refresh": "pnpm install",
    "run:ios": "bash scripts/check-native-cache.sh && cd apps/host && pnpm exec rnef run:ios",
    "e2e": "APP_ID=com.mf.example.host node --import tsx scripts/e2e-ota.tsx",
    "e2e:dev": "APP_ID=com.mf.example.host node --import tsx scripts/e2e-ota.tsx --dev",
    "e2e:demo": "APP_ID=com.mf.example.host node --import tsx scripts/e2e-ota.tsx --interactive",
    "e2e:zephyr": "APP_ID=com.mf.example.host ZEPHYR_E2E=1 node --env-file-if-exists=.env.e2e --import tsx scripts/e2e-ota-zephyr.tsx",
    "xcode:zephyr": "bash scripts/xcode-zephyr.sh",
    "e2e:build": "bash scripts/build-e2e-versions.sh",
    "test:release-config": "node --test scripts/lib/zephyr-distribution.test.cjs",
    "testflight:preflight": "node --env-file-if-exists=.env.testflight scripts/testflight.mjs preflight",
    "testflight:settings": "node --env-file-if-exists=.env.testflight scripts/testflight.mjs settings",
    "testflight:publish-remotes": "node --env-file-if-exists=.env.testflight scripts/testflight.mjs publish-remotes",
    "testflight:e2e": "node --env-file-if-exists=.env.testflight scripts/testflight.mjs e2e",
    "testflight:xcode": "node --env-file-if-exists=.env.testflight scripts/testflight.mjs xcode",
    "testflight:archive": "node --env-file-if-exists=.env.testflight scripts/testflight.mjs archive",
    "testflight:verify-archive": "node --env-file-if-exists=.env.testflight scripts/testflight.mjs verify-archive"
  },
  "devDependencies": {
    "@types/node": "^25.6.0",
    "@types/react": "^19.2.14",
    "execa": "^9.6.1",
    "ink": "7",
    "react": "^19.2.5",
    "tsx": "^4.21.0",
    "turbo": "^2.8.0"
  },
  "packageManager": "pnpm@10.33.0",
  "engines": {
    "node": ">=20"
  },
  "pnpm": {
    "overrides": {
      "@module-federation/error-codes": "2.9.0",
      "@module-federation/metro": "2.9.0",
      "@module-federation/metro-plugin-rnef": "2.9.0",
      "@module-federation/sdk": "2.9.0",
      "@module-federation/runtime-core": "2.9.0",
      "@module-federation/runtime": "2.9.0"
    },
    "onlyBuiltDependencies": [
      "esbuild"
    ]
  }
}
